// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Livestream {
  id               String                 @id @default(uuid())
  slug             String                 @unique
  streamerName     String
  title            String
  liveAt           DateTime
  endAt            DateTime?
  peakViewers      Int                    @default(0)
  avgViewers       Float                  @default(0)
  createdAt        DateTime               @default(now())

  snapshots        Snapshot[]
  chatSnapshots    ChatSnapshot[]
  topWords         ChatTopWord[]
}

model Snapshot {
  id              Int        @id @default(autoincrement())
  viewCount       Int        // Penonton bersamaan (CCU)
  recordedAt      DateTime   @default(now())

  // Relationship
  livestreamId    String
  livestream      Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)

  @@index([livestreamId, recordedAt])
}

model ChatSnapshot {
  id            Int        @id @default(autoincrement())
  messageCount  Int        @default(0)
  positiveCount Int        @default(0)
  neutralCount  Int        @default(0)
  negativeCount Int        @default(0)
  recordedAt    DateTime   @default(now())

  livestreamId  String
  livestream    Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)

  @@index([livestreamId, recordedAt])
}

model ChatTopWord {
  id           Int        @id @default(autoincrement())
  word         String
  count        Int        @default(0)

  livestreamId String
  livestream   Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)

  @@unique([livestreamId, word])
  @@index([livestreamId])
}